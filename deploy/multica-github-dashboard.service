[Unit]
Description=AntMultica GitHub review dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/wangyunlai.wyl/multica-github-dispatcher
ExecStart=/data/wangyunlai.wyl/multica-github-dispatcher/bin/multica-github-dispatcher dashboard --config /data/wangyunlai.wyl/multica-github-dispatcher/config.yaml
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
